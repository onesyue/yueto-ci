package subscribe

import (
	"context"
	"errors"
	"fmt"
	"regexp"
	"slices"
	"strconv"
	"strings"

	"github.com/jackc/pgx/v5"
	"go.yaml.in/yaml/v3"

	"github.com/onesyue/yueboard/internal/platform/i18n"
)

// renderClashMeta 加载模板 → 注入 proxies → proxy-group 合并 → rules → dump。
//
// tmplName 决定用哪张 Clash 系模板渲染，三张模板同构（proxies/proxy-groups/rules
// 三段结构一致），差别只在 rule-providers 的 behavior 与 geodata 依赖：
//   - clashmeta：.mrs 二进制 rule-provider，**仅 mihomo ≥1.18.7 能解析**
//   - clash    ：behavior: classical 文本 + geodata-mode，老 Clash 内核可解析；
//     节点只留老内核认识的类型，全被剔除时换成升级提示占位（clash_legacy_core.go）
//   - stash    ：同 classical，按 Stash 自身语法裁剪
//
// 老客户端拿到 clashmeta 会整份解析失败（"cannot unmarshal !!seq into string"
// / "could not switch to this profile"），故按 UA 分流到对应模板。
func (m *Module) renderClashMeta(
	ctx context.Context,
	trustedSubscriptionDomain string,
	u *subUser,
	servers []*serverRow,
	rejected int,
	tmplName string,
	// geckoOK：这个客户端是否**可证明**认识 hysteria2 的 gecko 混淆。
	// 认不出就是 false —— 与 surgeObfsParameter 同一形状，宁可回落 salamander。
	geckoOK bool,
	// realityMLKEM：这个客户端是否是可证明支持 support-x25519mlkem768 的 YueLink
	// （yuelinkSupportsRealityMLKEM）。只在 clashmeta 模板上生效。
	realityMLKEM bool,
	// connTag：本次交付里哪些代理类型打 yue-conn-tag（见 conn_tag.go）。
	connTag connTagScope,
) ([]byte, error) {
	if tmplName == "" {
		tmplName = "clashmeta"
	}
	tmpl, err := m.template(ctx, tmplName)
	if err != nil && (tmplName == "clashmeta" || !errors.Is(err, pgx.ErrNoRows)) {
		return nil, err
	}
	// 模板行缺失/为空（运维误删）时回落 clashmeta，绝不给用户发空配置。
	// 「行缺失」是 ErrNoRows：此前只有「内容为空」会回落，行被删时直接 500
	// （2026-09-21 审计）——与这句注释的承诺相反。
	if strings.TrimSpace(tmpl) == "" && tmplName != "clashmeta" {
		if tmpl, err = m.template(ctx, "clashmeta"); err != nil {
			return nil, err
		}
	}
	// 【保真关键】用 yaml.Node 解析而非 map[string]any 全量往返：后者会**解析 YAML anchor 别名并在
	// 序列化时展开**（rule-providers 等共享块被复制 → 输出膨胀数倍）且**丢失注释**，与 Xboard 输出
	// 结构不一致。yaml.Node 保留 anchor/注释/键序，只把 proxies/proxy-groups/rules 三段的值节点替换成
	// 我们计算好的内容（复用既有 buildProxy/mergeProxyGroups/buildRules），其余节点（含 rule-providers/
	// dns 的 anchor 与注释）**原样透传**。
	doc, err := m.clashTemplateDocument(tmplName+"\x00"+i18n.FromContext(ctx), tmpl)
	if err != nil {
		return nil, err
	}
	root := yamlDocRoot(doc)
	if root == nil || root.Kind != yaml.MappingNode {
		return nil, fmt.Errorf("%s 模板顶层不是映射", tmplName)
	}

	// 老 Clash 内核（Clash Premium / 开源 Clash）认不出 hysteria2 / vless：只留它能解析的
	// 节点，一个不剩时换成升级提示占位（clash_legacy_core.go）。必须在信息节点之前——
	// 信息节点从列表首行克隆，这样它们也跟着成为老内核能解析的占位。
	if tmplName == "clash" && legacyClashCoreFrom(ctx) {
		servers = legacyClashCoreServers(ctx, servers, geckoOK)
	}
	// 信息节点前缀（可选，show_info_to_server_enable）
	servers = m.prependInfoServers(ctx, u, servers, rejected)

	// proxy-groups 先取出来：Clash 系比其它渲染器多两类重名雷区——与 mihomo 内建出站
	// 同名、与模板里的策略组同名，两者都走同一句 "the duplicate name" 让整份配置报废。
	pg := map[string]any{"proxy-groups": normalizeYAML(yamlMapGet(root, "proxy-groups"))}
	base, _ := normalizeYAML(yamlMapGet(root, "proxies")).([]any)
	reserved := make([]string, 0, len(clashReservedProxyNames)+len(base))
	reserved = append(reserved, clashReservedProxyNames...)
	reserved = append(reserved, clashGroupNames(pg["proxy-groups"])...)
	reserved = append(reserved, clashTemplateProxyNames(base)...)
	servers = dedupeServerNames(servers, reserved)

	var proxyObjs []any
	var names []string
	transportOf := map[string]string{}
	for _, s := range servers {
		if p, ok := buildProxy(s, geckoOK); ok {
			transportOf[s.Name] = transportOfRow(s, p)
			if tmplName == "stash" {
				adaptStashProxy(p)
			}
			if realityMLKEM && tmplName == "clashmeta" {
				enableRealityMLKEM(p)
			}
			connTag.markConnTag(p)
			proxyObjs = append(proxyObjs, p)
			names = append(names, s.Name)
		}
	}

	// Resolve strict groups before serialization: unavailable defaults add a
	// native discard-port notice while regional/manual groups remain intact.
	notices := mergeProxyGroupsByTransport(pg, names, clashTemplateProxyNames(base), transportOf,
		i18n.T(i18n.FromContext(ctx), defaultGroupUnavailableNotice))
	for _, notice := range notices {
		proxyObjs = append(proxyObjs, notice)
		names = append(names, notice["name"].(string))
	}
	// proxies：模板自带占位（从节点解出）+ 生成节点，回写。
	if err := yamlMapSet(root, "proxies", append(base, proxyObjs...)); err != nil {
		return nil, err
	}
	// proxies 条目钉行内 flow（单行 `- {…}`）：历史 Xboard/PHP 渲染器即此形式，
	// YueLink 的 HysteriaTransformer（iOS 接收窗口钳制/带宽 strip）与其全部
	// golden 都按单行条目假设——块形式会让 iOS 的 8/16MiB 窗口钳制静默失效，
	// 40/80MiB 原样进 NE 触达 jetsam 界限（yuelink docs/debt.md 2026-08-12）。
	// yaml.v3 的 flow 输出不折行（>900 字符实测单行），嵌套 map/seq 在 flow
	// 上下文自动跟随，只需设置顶层条目 Style。
	if pn := yamlMapValueNode(root, "proxies"); pn != nil && pn.Kind == yaml.SequenceNode {
		for _, item := range pn.Content {
			item.Style = yaml.FlowStyle
		}
	}

	// proxy-groups / rules：复用既有逻辑（小 map 承载 → 计算 → 回写节点）。
	if err := yamlMapSet(root, "proxy-groups", pg["proxy-groups"]); err != nil {
		return nil, err
	}
	rl := map[string]any{"rules": normalizeYAML(yamlMapGet(root, "rules")), "sub-rules": normalizeYAML(yamlMapGet(root, "sub-rules"))}
	buildRules(rl, trustedSubscriptionDomain, clashOwnServiceTarget(pg["proxy-groups"]))
	// Prune/repoint rules whose target group mergeProxyGroups just removed.
	// A ?filter=/?types= that empties a region group leaves rules like
	// `GEOIP,HK,🇭🇰 香港` pointing at a group no longer in proxy-groups, which
	// makes mihomo/Clash reject the whole profile — the same class the sing-box
	// renderer already handles, but Clash had no equivalent (audit Y-7).
	// 模板自带的静态代理（proxies 段原样保留的占位节点）同样是合法目标——此前不在有效集里，
	// 直接指向它们的规则被改指到第一个策略组（2026-09-21 审计）。
	pruneClashRules(rl, pg, slices.Concat(names, clashTemplateProxyNames(base)))
	if err := yamlMapSet(root, "rules", rl["rules"]); err != nil {
		return nil, err
	}
	if rl["sub-rules"] != nil {
		if err := yamlMapSet(root, "sub-rules", rl["sub-rules"]); err != nil {
			return nil, err
		}
	}

	// $app_name is substituted **into the node tree**, not into the marshalled
	// bytes. Everything above exists to let yaml.Marshal guarantee structure;
	// rewriting its output afterwards gives that guarantee back. app_name is
	// admin-settable, so a value containing `: `, `#`, a quote or a newline used
	// to produce structurally invalid YAML after every structural check had
	// already passed — the same class of defect as the 2026-08-12 inline-flow
	// incident (a format assumption living in a pattern instead of in the
	// emitter). Substituting before Marshal lets the emitter quote as needed,
	// and confines the replacement to scalars so anchors/aliases are untouched.
	substituteYAMLScalars(doc, "$app_name", m.settings.Get(ctx, "app_name", "YueBoard"))
	quoteSubscriptionStrings(doc)
	out, err := yaml.Marshal(doc)
	if err != nil {
		return nil, err
	}
	return out, nil
}

