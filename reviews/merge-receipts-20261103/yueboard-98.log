+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestExternalNodeSaveValidation(t *testing.T) {
+	for _, typ := range []string{"vless", "vmess", "tuic", "hysteria"} {
+		for _, credential := range []string{"", "invalid", "AABBCCDD1234456789AB123456789ABC"} {
+			t.Run(typ+"/"+credential, func(t *testing.T) {
+				raw, _ := json.Marshal([]any{map[string]any{"type": typ, "password": credential}})
+				patch := map[string]any{"local_nodes": string(raw)}
+				err := (&Module{}).plValidateConfigPatch(context.Background(), "node_ext", patch)
+				valid := typ == "hysteria" || len(credential) == 32
+				if (err == nil) != valid {
+					t.Fatalf("error = %v", err)
+				}
+				if !valid && !strings.Contains(err.Error(), "UUID") {
+					t.Fatalf("unclear error: %v", err)
+				}
+				if valid && typ != "hysteria" && !strings.Contains(patch["local_nodes"].(string), "aabbccdd-1234-4567-89ab-123456789abc") {
+					t.Fatal("save did not normalize UUID")
+				}
+			})
+		}
+	}
+}
