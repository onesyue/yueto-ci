package nodeext

// Clash proxies → 系统节点转换。生产导入面只接受原始 vless 与 hysteria2；
// hysteria2 在系统内部归一化为 type=hysteria + protocol_settings.version=2。

import (
	"log/slog"
	"strings"

	"go.yaml.in/yaml/v3"

	"github.com/onesyue/yueboard/internal/platform/nodecredential"
)

var neClashSupportedTypes = map[string]bool{
	"hysteria2": true,
	"vless":     true,
}

// neParseClashYAML 解析顶层 proxies；解析失败或字段形态错误均返回空。
func neParseClashYAML(yamlText string) []any {
	var doc map[string]any
	if err := yaml.Unmarshal([]byte(yamlText), &doc); err != nil {
		slog.Warn("nodeext: Clash YAML 解析失败", "err", err)
		return nil
	}
	proxies, _ := doc["proxies"].([]any)
	return proxies
}

// neConvertClashProxies 只转换生产协议；其余类型即使 YAML 合法也直接跳过。
func neConvertClashProxies(proxies []any) []Node {
	var result []Node
	for _, raw := range proxies {
		p, ok := raw.(map[string]any)
		if !ok {
			continue
		}
		typ := strings.ToLower(neToString(neDataGet(p, "type", "")))
		if !neClashSupportedTypes[typ] {
			continue
		}
		name := neTrim(neToString(neDataGet(p, "name", "")))
		host := neTrim(neToString(neDataGet(p, "server", "")))
		port := neToInt(neDataGet(p, "port", 0))
		if name == "" || host == "" || port < 1 || port > 65535 {
			continue
		}

		n := Node{
			Type:     typ,
			Name:     name,
			Host:     host,
			Port:     port,
			Password: neToString(neDataGet(p, "password", neDataGet(p, "uuid", ""))),
			Rate:     "1.00",
			Tags:     []string{"clash"},
		}
		credential, err := nodecredential.Normalize(n.Type, n.Password)
		if err != nil {
			continue
		}
		n.Password = credential
		switch typ {
		case "vless":
			// Clash 类型名是 vless 仍不够：生产节点形态固定为 TCP + Reality + Vision。
			if neClashCaseString(neDataGet(p, "network", "tcp")) != "tcp" ||
				!nePHPTruthy(neDataGet(p, "tls", nil)) ||
				!nePHPTruthy(neDataGet(p, "reality-opts", nil)) ||
				neToString(neDataGet(p, "flow", "")) != "xtls-rprx-vision" {
				continue
			}
			n.ProtocolSettings = neClashVless(p)
		case "hysteria2":
			n.Type = "hysteria"
			n.ProtocolSettings = map[string]any{
				"version": 2,
				"bandwidth": map[string]any{
					"up":   neDataGet(p, "up", nil),
					"down": neDataGet(p, "down", nil),
				},
				"obfs": map[string]any{
					"open":     nePHPTruthy(neDataGet(p, "obfs", nil)),
					"type":     neDataGet(p, "obfs", "salamander"),
					"password": neDataGet(p, "obfs-password", nil),
				},
				"tls": neClashTLSBlock(p),
			}
		}
		result = append(result, n)
	}
	return result
}

// neClashVless 保留 Clash VLESS 字段映射；生产 DB 的最终形态由上层约束为
// TCP + Reality + xtls-rprx-vision。
func neClashVless(p map[string]any) map[string]any {
	tls := 0
	var tlsSettings, realitySettings any
	if nePHPTruthy(neDataGet(p, "tls", nil)) {
		if nePHPTruthy(neDataGet(p, "reality-opts", nil)) {
			tls = 2
			realitySettings = map[string]any{
				"allow_insecure": neDataGet(p, "skip-cert-verify", false),
				"server_name":    neDataGet(p, "servername", nil),
				"public_key":     neDataGet(p, "reality-opts.public-key", nil),
				"short_id":       neDataGet(p, "reality-opts.short-id", nil),
			}
		} else {
			tls = 1
			tlsSettings = map[string]any{
				"allow_insecure": neDataGet(p, "skip-cert-verify", false),
				"server_name":    neDataGet(p, "servername", nil),
			}
		}
	}
	return map[string]any{
		"flow":             neDataGet(p, "flow", nil),
		"network":          neDataGet(p, "network", "tcp"),
		"tls":              tls,
		"tls_settings":     tlsSettings,
		"reality_settings": realitySettings,
		"network_settings": neClashWsGrpcSettings(p),
	}
}

func neClashWsGrpcSettings(p map[string]any) any {
	switch neClashCaseString(neDataGet(p, "network", nil)) {
	case "ws":
		return map[string]any{
			"path":    neDataGet(p, "ws-opts.path", nil),
			"headers": neDataGet(p, "ws-opts.headers", []any{}),
		}
	case "grpc":
		return map[string]any{
			"serviceName": neDataGet(p, "grpc-opts.grpc-service-name", nil),
		}
	}
	return nil
}

func neClashTLSBlock(p map[string]any) map[string]any {
	return map[string]any{
		"server_name":    neDataGet(p, "sni", nil),
		"allow_insecure": neDataGet(p, "skip-cert-verify", false),
	}
}

func neClashCaseString(v any) string {
	s, _ := v.(string)
	return s
