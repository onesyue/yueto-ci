new file mode 100644
index 00000000..dc9e7e98
--- /dev/null
+++ b/internal/modules/nodeext/validation_test.go
@@ -0,0 +1,90 @@
+package nodeext
+
+import "testing"
+
+func TestExternalUUIDCredentials(t *testing.T) {
+	const canonical = "aabbccdd-1234-4567-89ab-123456789abc"
+	cases := []struct {
+		name, credential string
+		valid            bool
+	}{
+		{"canonical", canonical, true},
+		{"uppercase", "AABBCCDD-1234-4567-89AB-123456789ABC", true},
+		{"compact", "AABBCCDD1234456789AB123456789ABC", true},
+		{"empty", "", false}, {"arbitrary", "password", false},
+		{"bad hex", "zzbbccdd-1234-4567-89ab-123456789abc", false},
+		{"bad separator", "aabbccdd_1234-4567-89ab-123456789abc", false},
+		{"braces", "{" + canonical + "}", false}, {"urn", "urn:uuid:" + canonical, false},
+	}
+	for _, typ := range []string{"vless", "vmess", "tuic"} {
+		for _, tc := range cases {
+			t.Run(typ+"/"+tc.name, func(t *testing.T) {
+				node := map[string]any{"type": typ, "name": "test", "host": "example.com", "port": 443, "password": tc.credential}
+				got := neNormalizeNodes([]any{node})
+				if (len(got) == 1) != tc.valid {
+					t.Fatalf("nodes = %#v", got)
+				}
+				if tc.valid && got[0].Password != canonical {
+					t.Fatalf("credential = %q", got[0].Password)
+				}
+				if typ == "vless" {
+					proxy := map[string]any{"type": typ, "name": "test", "server": "example.com", "port": 443, "uuid": tc.credential, "network": "tcp", "tls": true, "flow": "xtls-rprx-vision", "reality-opts": map[string]any{"public-key": "PBK"}}
+					got = neConvertClashProxies([]any{proxy})
+					if (len(got) == 1) != tc.valid {
+						t.Fatalf("Clash nodes = %#v", got)
+					}
+					if tc.valid && got[0].Password != canonical {
+						t.Fatalf("Clash credential = %q", got[0].Password)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestExternalJSONEndpointsAndMixedList(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		host  any
+		port  any
+		valid bool
+	}{
+		{"minimum", "example.com", 1, true}, {"maximum", "example.com", 65535, true},
+		{"string port", "example.com", "443", true}, {"missing host", nil, 443, false},
+		{"empty host", "", 443, false}, {"blank host", " \t", 443, false},
+		{"missing port", "example.com", nil, false}, {"zero", "example.com", 0, false},
+		{"negative", "example.com", -1, false}, {"overflow", "example.com", 65536, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			node := map[string]any{"name": "candidate", "type": "hysteria", "host": tc.host, "port": tc.port, "password": "not-a-uuid"}
+			good := map[string]any{"name": "good", "type": "trojan", "host": "example.com", "port": 443, "password": "arbitrary"}
+			got := neNormalizeNodes([]any{node, good})
+			want := 1
+			if tc.valid {
+				want++
+			}
+			if len(got) != want || got[len(got)-1].Name != "good" {
+				t.Fatalf("nodes = %#v", got)
+			}
+		})
+	}
+}
+
+func TestMalformedUUIDDoesNotDiscardValidNeighbors(t *testing.T) {
+	const credential = "aabbccdd-1234-4567-89ab-123456789abc"
+	var local, clash []any
+	for _, password := range []string{credential, "malformed", credential} {
+		local = append(local, map[string]any{"type": "vless", "name": "node", "host": "example.com", "port": 443, "password": password})
+		clash = append(clash, map[string]any{"type": "vless", "name": "node", "server": "example.com", "port": 443, "uuid": password, "tls": true, "flow": "xtls-rprx-vision", "reality-opts": map[string]any{"public-key": "PBK"}})
+	}
+	for source, nodes := range map[string][]Node{"JSON": neNormalizeNodes(local), "Clash": neConvertClashProxies(clash)} {
+		if len(nodes) != 2 {
+			t.Fatalf("%s kept %d nodes, want 2", source, len(nodes))
+		}
+		for _, node := range nodes {
+			if node.Password != credential {
+				t.Fatalf("%s retained bad credential", source)
+			}
+		}
+	}
+}
