package nodeext

// 配置读取:SELECT is_enabled, config FROM plugins WHERE code='node_ext'(config 为 JSON 文本),
// 60s 进程内缓存(照 emby 模式)。宽松解析逐点对齐 PHP:
//   - getConfig(key, default) 用 ?? 实现 → JSON null 一律视同「键缺失,取默认值」;
//   - enable            —— getConfig('enable', true) 后直接真值判断(注意 PHP 怪癖:字符串
//     "false" 为真值 → 启用;"0"/0/false 才是关闭);
//   - clash_cache_enable —— boolConfig(...,true):bool 原样;其余走 filter_var(...BOOLEAN,
//     NULL_ON_FAILURE),识别 "1/true/on/yes"、"0/false/off/no/"",无法识别时取默认 true;
//   - clash_cache_ttl    —— (int) 弱转换后 clamp 到 [60,3600](PHP: max(60, min(3600, …)));
//   - 三个来源字段是字符串;数字/布尔按 PHP (string) 弱转换,数组/对象等价于 PHP 的
//     "Array"(必然解析失败)→ 按缺失处理。
// 双重开关与 PHP 一致:plugins.is_enabled=false(插件停用,boot 不会执行)或 enable 配置
// 为假,均视为关闭。行不存在/查询失败 → 视为未安装 → 关闭(fail-open 到空节点)。

import (
	"context"
	"encoding/json"
	"strings"
)

const (
	nePluginCode = "node_ext"
	neMaxNodes   = 500
)

// neConfig 是归一化后的插件配置(对齐 config.json 的键)。
type neConfig struct {
	Enable           bool
	LocalNodes       string
	APIURL           string
	ClashSubURL      string
	ClashCacheEnable bool
	ClashCacheTTL    int // 秒,已 clamp 到 [60,3600]
}

// neDefaultConfig 是各键缺失时的代码级默认值(与 PHP 各 getConfig 调用点的默认一致;
// config.json 里 clash_cache_enable 默认 false 只影响安装时写库的初始值,代码默认是 true)。
func neDefaultConfig() neConfig {
	return neConfig{Enable: true, ClashCacheEnable: true, ClashCacheTTL: 600}
}

// config 组装插件配置:经共享 pluginconfig 读 plugins.config(code='node_ext',60s 缓存),
// 再以 PHP 忠实语义套到默认配置上。注意:字段解析用的是 nodeext 自己的 PHP 兼容器
// (enable 用原始真值 nePHPTruthy——"false" 为真;clash_cache_enable 用 filter_var;
// 各来源字段用弱字符串;ttl 弱转换后 clamp),而非 pluginconfig 的宽松 Bool/Int/Str——
// 二者语义不同,故此处仅借 pluginconfig 做「读库 + is_enabled + 缓存」,取值仍走 .Raw。
func (m *Module) config(ctx context.Context) neConfig {
	cfg := neDefaultConfig()
	if m.pc == nil {
		// 无配置读取器(未接线/单测):PHP 里插件不加载 → filter 不存在 → 无外挂节点。
		cfg.Enable = false
	} else {
		pcfg := m.pc.Load(ctx, nePluginCode)
		neApplyRawConfig(&cfg, pcfg.Raw)
		// 双重开关:plugins.is_enabled=false(插件停用)强制关闭,与 PHP 一致。
		// 查询失败时 pluginconfig 返回 Enabled=false + 空配置 → 亦落此分支关闭。
		if !pcfg.Enabled {
			cfg.Enable = false
		}
	}
	cfg.ClashCacheTTL = neClampTTL(cfg.ClashCacheTTL)
	return cfg
}

// neApplyRawConfig 把 plugins.config 的各键宽松地套到默认配置上。get 是按键取原始 JSON 值的
// 访问器(生产传 pluginconfig.Config.Raw;单测传基于 map 的闭包),缺键/null → 保留默认。
func neApplyRawConfig(cfg *neConfig, get func(string) (json.RawMessage, bool)) {
	val := func(key string) (any, bool) {
		raw, _ := get(key)
		return neJSONValue(raw) // 缺键/null/解析失败 → ok=false(getConfig 的 ?? 语义)
	}
	if v, ok := val("enable"); ok {
		cfg.Enable = nePHPTruthy(v) // 原始真值判断,非 filter_var
	}
	if v, ok := val("local_nodes"); ok {
		cfg.LocalNodes = neWeakString(v)
	}
	if v, ok := val("api_url"); ok {
		cfg.APIURL = neWeakString(v)
	}
	if v, ok := val("clash_sub_url"); ok {
		cfg.ClashSubURL = neWeakString(v)
	}
	if v, ok := val("clash_cache_enable"); ok {
		if b, bok := neFilterBool(v); bok {
			cfg.ClashCacheEnable = b
		}
	}
	if v, ok := val("clash_cache_ttl"); ok {
		switch v.(type) {
		case float64, string, bool:
			cfg.ClashCacheTTL = neToInt(v)
		}
	}
}

// neJSONValue 解出某键的 JSON 值;键缺失、解析失败或值为 null(getConfig 的 ?? 语义)→ ok=false。
func neJSONValue(raw json.RawMessage) (any, bool) {
	if len(raw) == 0 {
		return nil, false
	}
	var v any
	if err := json.Unmarshal(raw, &v); err != nil {
		return nil, false
	}
	if v == nil {
		return nil, false
	}
	return v, true
}

// neWeakString 是配置字符串字段的 PHP (string) 弱转换;数组/对象按缺失处理(PHP 会得到
// "Array" 字符串,后续解析必然失败,结果等价)。
func neWeakString(v any) string {
	switch v.(type) {
	case string, float64, bool:
		return neToString(v)
	default:
		return ""
	}
}

// neFilterBool 复刻 filter_var($v, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE)
// (bool 原样;字符串识别 on/off 等;数字仅 1/0;其余无法识别 → ok=false,调用方保留默认)。
func neFilterBool(v any) (val, ok bool) {
	switch t := v.(type) {
	case bool:
		return t, true
	case string:
		switch strings.ToLower(strings.TrimSpace(t)) {
		case "1", "true", "on", "yes":
			return true, true
		case "0", "false", "off", "no", "":
			return false, true
		}
		return false, false
	case float64:
		if t == 1 {
			return true, true
		}
		if t == 0 {
			return false, true
		}
		return false, false
	default:
		return false, false
	}
}

// neClampTTL 对齐 max(60, min(3600, ttl))。
func neClampTTL(ttl int) int {
	if ttl < 60 {
		return 60
	}
	if ttl > 3600 {
		return 3600
	}
	return ttl
}
