// ───────────────────────────── local_nodes ─────────────────────────────

// localNodes 对齐 getLocalNodes:配置 JSON 数组 → normalize。
func (m *Module) localNodes(cfg neConfig) []Node {
	s := cfg.LocalNodes
	if s == "" || s == "0" { // PHP:(string)getConfig('local_nodes','[]') ?: '[]'
		s = "[]"
	}
	items, ok := neDecodeJSONList([]byte(s))
	if !ok {
		slog.Warn("nodeext: local_nodes is not valid JSON array")
		return nil
	}
	return neNormalizeNodes(items)
}

// neDecodeJSONList 对齐 json_decode($json, true) + is_array 检查:
// JSON 数组 → 原序;JSON 对象在 PHP 里也是数组(assoc),取其值(按键排序,见分歧清单);
// 标量/null/非法 JSON → 无效。
func neDecodeJSONList(data []byte) ([]any, bool) {
	var v any
	if err := json.Unmarshal(data, &v); err != nil {
		return nil, false
	}
	switch t := v.(type) {
	case []any:
		return t, true
	case map[string]any:
		vals := make([]any, 0, len(t))
		for _, k := range neSortedKeys(t) {
			vals = append(vals, t[k])
		}
		return vals, true
	default:
		return nil, false
	}
}

// neNormalizeNodes 对齐 normalizeNodes:逐条校验并转为强类型 Node,上限 neMaxNodes 条。
//   - name/type 任一 empty()(缺失/null/false/0/"0"/"")→ 跳过;
//   - A non-empty host, port in 1..65535 and valid UUID credentials are required.
//   - tags 非数组 → []。
func neNormalizeNodes(items []any) []Node {
	nodes := make([]Node, 0, min(len(items), neMaxNodes))
	for _, it := range items {
		node, ok := it.(map[string]any)
		if !ok {
			continue
		}
		if !nePHPTruthy(node["name"]) || !nePHPTruthy(node["type"]) { // empty() 检查
			continue
		}
		port := neToInt(node["port"])
		if port < 1 || port > 65535 || strings.TrimSpace(neToString(node["host"])) == "" {
			continue
		}
		password, err := nodecredential.Normalize(neToString(node["type"]), neToString(node["password"]))
		if err != nil {
			continue
		}
		var tags []string
		switch tv := node["tags"].(type) {
		case []any:
			tags = make([]string, 0, len(tv))
			for _, t := range tv {
				tags = append(tags, neToString(t))
			}
		case map[string]any: // JSON 对象在 PHP json_decode(assoc) 后 is_array 也为真
			tags = make([]string, 0, len(tv))
			for _, k := range neSortedKeys(tv) {
				tags = append(tags, neToString(tv[k]))
			}
		default:
			tags = []string{}
		}
		n := Node{
			Type:     neToString(node["type"]),
			Name:     neToString(node["name"]),
			Host:     neToString(node["host"]),
			Port:     port,
			Password: password,
			Rate:     "1.00",
			Tags:     tags,
		}
		if rv, exists := node["rate"]; exists {
			if s := neToString(rv); s != "" {
				n.Rate = s
			}
		}
		if psv, ok := node["protocol_settings"].(map[string]any); ok {
			n.ProtocolSettings = psv
		}
		nodes = append(nodes, n)
		if len(nodes) >= neMaxNodes {
			break
		}
	}
	return nodes
}
