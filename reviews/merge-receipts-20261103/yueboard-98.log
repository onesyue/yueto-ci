+++ b/internal/modules/admin/plugin_nodeext.go
@@ -0,0 +1,61 @@
+package admin
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/onesyue/yueboard/internal/platform/nodecredential"
+)
+
+// Validate only submitted local nodes; remote imports are checked on load.
+func plValidateExternalNodes(patch map[string]any) error {
+	raw, exists := patch["local_nodes"]
+	if !exists || raw == nil || raw == "" || raw == "0" {
+		return nil
+	}
+	text, ok := raw.(string)
+	if !ok {
+		return fmt.Errorf("local_nodes must contain a JSON array or object")
+	}
+	var decoded any
+	if err := json.Unmarshal([]byte(text), &decoded); err != nil {
+		return fmt.Errorf("local_nodes must contain valid JSON")
+	}
+	var items []any
+	switch v := decoded.(type) {
+	case []any:
+		items = v
+	case map[string]any:
+		for _, item := range v {
+			items = append(items, item)
+		}
+	default:
+		return fmt.Errorf("local_nodes must contain a JSON array or object")
+	}
+	changed := false
+	for i, item := range items {
+		node, ok := item.(map[string]any)
+		if !ok {
+			return fmt.Errorf("local_nodes entry %d must be an object", i+1)
+		}
+		typ, _ := node["type"].(string)
+		password, _ := node["password"].(string)
+		normalized, err := nodecredential.Normalize(typ, password)
+		if err != nil {
+			return fmt.Errorf("local_nodes entry %d: %w", i+1, err)
+		}
+		if normalized != password {
+			node["password"] = normalized
+			changed = true
+		}
+	}
+	if !changed {
+		return nil
+	}
+	encoded, err := json.Marshal(decoded)
+	if err != nil {
+		return err
+	}
+	patch["local_nodes"] = string(encoded)
+	return nil
+}
