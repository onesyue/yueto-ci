diff --git a/internal/modules/subscribe/yaml_string_roundtrip_test.go b/internal/modules/subscribe/yaml_string_roundtrip_test.go
new file mode 100644
index 00000000..8d393d44
--- /dev/null
+++ b/internal/modules/subscribe/yaml_string_roundtrip_test.go
@@ -0,0 +1,77 @@
+package subscribe
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	yaml "go.yaml.in/yaml/v3"
+	legacyyaml "gopkg.in/yaml.v3"
+)
+
+func TestSubscriptionStringQuoting(t *testing.T) {
+	for _, value := range []string{"6e43", "00000000", "1234", "0x1f", "true", "null", "1e5", "1e999", "0xffffffffffffffffffffffff", ".inf", "012", "yes", "NO", "on", "Off", "y", "N", "1:20", "2001-12-15", "ordinary"} {
+		t.Run(value, func(t *testing.T) {
+			for _, flow := range []bool{false, true} {
+				n, err := subscriptionValueNode(map[string]any{"value": value, "list": []string{value}, value: value})
+				if err != nil {
+					t.Fatal(err)
+				}
+				quoteSubscriptionStrings(n)
+				if flow {
+					n.Style = yaml.FlowStyle
+				}
+				out, err := yaml.Marshal(n)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var got map[string]any
+				if err := legacyyaml.Unmarshal(out, &got); err != nil {
+					t.Fatal(err)
+				}
+				if got["value"] != value || got[value] != value || got["list"].([]any)[0] != value {
+					t.Fatalf("strings changed: %s", out)
+				}
+				if value != "ordinary" && !strings.Contains(string(out), `"`+value+`"`) {
+					t.Fatalf("ambiguous value unquoted: %s", out)
+				}
+			}
+		})
+	}
+}
+
+func TestRealityShortIDYAMLRoundTrip(t *testing.T) {
+	for _, family := range []string{"clash", "clashmeta", "stash"} {
+		for _, shortID := range []string{"6e43", "00000000"} {
+			t.Run(family+"/"+shortID, func(t *testing.T) {
+				m := entryTestModule(t, family, quicRejectTemplate)
+				row := vlessRealityRow()
+				row.Settings["reality_settings"].(map[string]any)["short_id"] = shortID
+				out, err := m.renderClashMeta(context.Background(), "sub.example", entrySubUser(), []*serverRow{row}, 0, family, false, false, connTagScope{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				var doc struct {
+					Proxies []map[string]any `yaml:"proxies"`
+				}
+				if err := legacyyaml.Unmarshal(out, &doc); err != nil {
+					t.Fatal(err)
+				}
+				found := false
+				for _, proxy := range doc.Proxies {
+					if proxy["name"] != row.Name {
+						continue
+					}
+					found = true
+					reality, ok := proxy["reality-opts"].(map[string]any)
+					if !ok || reality["short-id"] != shortID {
+						t.Fatalf("short-id changed: %#v\n%s", proxy, out)
+					}
+				}
+				if !found {
+					t.Fatalf("proxy missing: %s", out)
+				}
+			})
+		}
+	}
+}
diff --git a/internal/modules/subscribe/yaml_value_node.go b/internal/modules/subscribe/yaml_value_node.go
index d49f36c9..1d12f8f7 100644
--- a/internal/modules/subscribe/yaml_value_node.go
+++ b/internal/modules/subscribe/yaml_value_node.go
@@ -1,8 +1,10 @@
 package subscribe
 
 import (
+	"regexp"
 	"slices"
 	"strconv"
+	"strings"
 
 	"go.yaml.in/yaml/v3"
 )
@@ -79,3 +81,27 @@ func subscriptionValueNode(value any) (*yaml.Node, error) {
 	}
 	return n, nil
 }
+
+// YAML 1.1 also resolves legacy booleans and sexagesimal numbers, which the
+// YAML 1.2-oriented resolver does not recognize. Quote both dialects safely.
+// Include numeric overflow: some parsers resolve values beyond Go numeric limits.
+var subscriptionNumber = regexp.MustCompile(`^[+-]?(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|(?:[0-9][0-9_]*(?:\.[0-9_]*)?|\.[0-9_]+)(?:[eE][+-]?[0-9]+)?)$`)
+
+var subscriptionSexagesimal = regexp.MustCompile(`^[+-]?[0-9][0-9_]*(?::[0-5]?[0-9])+(?:\.[0-9_]*)?$`)
+
+func quoteSubscriptionStrings(n *yaml.Node) {
+	if n.Kind == yaml.ScalarNode && n.Tag == "!!str" {
+		implicit := yaml.Node{Kind: yaml.ScalarNode, Value: n.Value}
+		legacy := false
+		switch strings.ToLower(n.Value) {
+		case "y", "n", "yes", "no", "on", "off":
+			legacy = true
+		}
+		if implicit.ShortTag() != "!!str" || legacy || subscriptionNumber.MatchString(n.Value) || subscriptionSexagesimal.MatchString(n.Value) {
+			n.Style = yaml.DoubleQuotedStyle
+		}
+	}
+	for _, child := range n.Content {
+		quoteSubscriptionStrings(child)
+	}
+}
diff --git a/internal/platform/nodecredential/uuid.go b/internal/platform/nodecredential/uuid.go
new file mode 100644
index 00000000..daaef9cc
--- /dev/null
+++ b/internal/platform/nodecredential/uuid.go
@@ -0,0 +1,23 @@
+// Package nodecredential validates credentials shared by external node imports and admin saves.
+package nodecredential
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/google/uuid"
+)
+
+// Normalize preserves password credentials and canonicalizes UUID credentials.
+func Normalize(typ, credential string) (string, error) {
+	switch strings.ToLower(typ) {
+	case "vless", "vmess", "tuic":
+		id, err := uuid.Parse(credential)
+		if err != nil || (len(credential) != 36 && len(credential) != 32) {
+			return "", fmt.Errorf("%s password must be a valid UUID (36-character canonical or 32 hexadecimal digits)", typ)
+		}
+		return id.String(), nil
+	default:
+		return credential, nil
+	}
+}

