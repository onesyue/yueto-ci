func plFieldType(t string) string {
	switch t {
	case "boolean", "number", "select", "text", "string", "password":
		return t
	default:
		return "string"
	}
}

func (m *Module) plGetConfig(w http.ResponseWriter, r *http.Request) {
	code := strings.TrimSpace(r.URL.Query().Get("code"))
	if code == "" {
		apiresp.Fail(w, http.StatusBadRequest, "缺少插件 code")
		return
	}
	ctx := r.Context()
	values := map[string]any{}
	var cfgRaw []byte
	if err := m.pool.QueryRow(ctx, `SELECT COALESCE(config,'{}') FROM plugins WHERE code=$1`, code).Scan(&cfgRaw); err == nil {
		values, err = plDecodeConfig(cfgRaw)
		if err != nil {
			apiresp.ServerError(w, r, err, "查询失败")
			return
		}
	} else if !errors.Is(err, pgx.ErrNoRows) {
		apiresp.ServerError(w, r, err, "查询失败")
		return
	}
	apiresp.Success(w, plBuildFields(plRegistry[code], plRevealSecretsForMask(code, values)))
}

func (m *Module) plUpdateConfig(w http.ResponseWriter, r *http.Request) {
	body, err := decodeBody(r)
	if err != nil {
		apiresp.ValidationFail(w, "请求参数格式错误", nil)
		return
	}
	code := strings.TrimSpace(giftStr(body["code"]))
	if code == "" {
		apiresp.Fail(w, http.StatusBadRequest, "缺少插件 code")
		return
	}
	cfg, ok := body["config"].(map[string]any)
	if !ok {
		apiresp.ValidationFail(w, "config 需为对象", nil)
		return
	}
	// Secret values are write-only. The mask (or an empty form field) means
	// "keep the current value"; a real non-empty replacement is accepted.
	plDropUnchangedSecrets(cfg)
	ctx := r.Context()
	// 部分插件的配置有跨字段不变式（动态限速的收敛梯子）。坏配置必须在**写库之前**
	// 被拒绝并把可执行提示回给管理员——存下去再让后台任务静默跳过，等于让
	// 「没在治理」和「治理中且无人命中」长成一个样。
	if err := m.plValidateConfigPatch(ctx, code, cfg); err != nil {
		apiresp.ValidationFail(w, err.Error(), nil)
		return
	}
	now := apptime.Now()
	// *_bot_token 静态加密（plugin_secret_vault.go）：补丁里的明文先加密；同一事务内
	// 行锁读出该行，把补丁没覆盖的旧明文同类键一并加密写回（过渡期惰性迁移）。
	// vault 未配置 → 拒绝保存，绝不把明文落库。
	vault := tokenvault.Default()
	auditKeys := auditConfigKeys(cfg) // 审计记管理员**提交**了哪些键，不含惰性迁移补进来的
	if err := plSealPatchSecrets(vault, cfg); err != nil {
		apiresp.ServerError(w, r, err, "保存失败")
		return
	}
	tx, err := m.pool.Begin(ctx)
	if err != nil {
		apiresp.ServerError(w, r, err, "保存失败")
		return
	}
	defer func() { _ = tx.Rollback(ctx) }()
	if err := plSealLegacyInRow(ctx, tx, vault, code, cfg); err != nil {
		apiresp.ServerError(w, r, err, "保存失败")
		return
	}
	patch := giftJSON(cfg)
	// 合并入现有 config（jsonb 拼接：新值覆盖同键）。行不存在则创建（补 registry 元信息）。
	// 生产存在遗留的非 object 形态行（`[]` / 字符串，见迁移 00040 的 jsonb_typeof 守卫）：
