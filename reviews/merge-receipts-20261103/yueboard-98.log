package subscribe

import (
	"regexp"
	"slices"
	"strconv"
	"strings"

	"go.yaml.in/yaml/v3"
)

// Node.Encode marshals to bytes and parses those bytes again. The generated
// subscription sections already contain normalized Go values; construct their
// nodes directly and let the final YAML emitter handle quoting and flow style.
// Keep the library path for uncommon types and custom YAML marshalers.
func subscriptionValueNode(value any) (*yaml.Node, error) {
	n := &yaml.Node{}
	scalar := func(tag, text string) { n.Kind, n.Tag, n.Value = yaml.ScalarNode, tag, text }
	switch v := value.(type) {
	case nil:
		scalar("!!null", "null")
	case string:
		// SetString also preserves the library's binary/non-UTF8 and multiline
		// handling; setting Value alone would change those template values.
		n.SetString(v)
	case bool:
		scalar("!!bool", strconv.FormatBool(v))
	case int:
		scalar("!!int", strconv.Itoa(v))
	case int64:
		scalar("!!int", strconv.FormatInt(v, 10))
	case uint64:
		scalar("!!int", strconv.FormatUint(v, 10))
	case []string:
		n.Kind, n.Tag = yaml.SequenceNode, "!!seq"
		n.Content = make([]*yaml.Node, len(v))
		for i, text := range v {
			child := &yaml.Node{}
			child.SetString(text)
			n.Content[i] = child
		}
	case []any:
		n.Kind, n.Tag = yaml.SequenceNode, "!!seq"
		n.Content = make([]*yaml.Node, len(v))
		for i, item := range v {
			child, err := subscriptionValueNode(item)
			if err != nil {
				return nil, err
			}
			n.Content[i] = child
		}
	case map[string]any:
		// Preserve the library's special merge-key interpretation for operator
		// template maps, including its validation of malformed merge values.
		if _, merge := v["<<"]; merge {
			if err := n.Encode(value); err != nil {
				return nil, err
			}
			return n, nil
		}
		n.Kind, n.Tag = yaml.MappingNode, "!!map"
		keys := make([]string, 0, len(v))
		for key := range v {
			keys = append(keys, key)
		}
		slices.Sort(keys)
		n.Content = make([]*yaml.Node, 0, 2*len(keys))
		for _, key := range keys {
			child, err := subscriptionValueNode(v[key])
			if err != nil {
				return nil, err
			}
			k := &yaml.Node{}
			k.SetString(key)
			n.Content = append(n.Content, k, child)
		}
	default:
		if err := n.Encode(value); err != nil {
			return nil, err
		}
	}
	return n, nil
}

// YAML 1.1 also resolves legacy booleans and sexagesimal numbers, which the
// YAML 1.2-oriented resolver does not recognize. Quote both dialects safely.
// Include numeric overflow: some parsers resolve values beyond Go numeric limits.
var subscriptionNumber = regexp.MustCompile(`^[+-]?(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|(?:[0-9][0-9_]*(?:\.[0-9_]*)?|\.[0-9_]+)(?:[eE][+-]?[0-9]+)?)$`)

var subscriptionSexagesimal = regexp.MustCompile(`^[+-]?[0-9][0-9_]*(?::[0-5]?[0-9])+(?:\.[0-9_]*)?$`)

func quoteSubscriptionStrings(n *yaml.Node) {
	if n.Kind == yaml.ScalarNode && n.Tag == "!!str" {
		implicit := yaml.Node{Kind: yaml.ScalarNode, Value: n.Value}
		legacy := false
		switch strings.ToLower(n.Value) {
		case "y", "n", "yes", "no", "on", "off":
			legacy = true
		}
		if implicit.ShortTag() != "!!str" || legacy || subscriptionNumber.MatchString(n.Value) || subscriptionSexagesimal.MatchString(n.Value) {
			n.Style = yaml.DoubleQuotedStyle
		}
	}
	for _, child := range n.Content {
		quoteSubscriptionStrings(child)
	}
}

