    app = m['load_app'](SERVICE)
    schema = m['snapshot'](app, SERVICE)
    contexts = list(iter_route_contexts(app.routes))
    expected = {(method.lower(), route.path_format) for route in contexts
                if isinstance(route.original_route, APIRoute) for method in route.methods}
    actual = {(method, path) for path, item in schema['paths'].items() for method in item}
    assert expected and expected == actual
    assert sum(len(route.methods) for route in contexts
               if isinstance(route.original_route, APIRoute)) == len(actual)
