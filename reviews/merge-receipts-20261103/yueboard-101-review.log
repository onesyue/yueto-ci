+			}
+			assertAuditCount()
+			if apply {
+				replay, err = service.PromoteOperation(ctx, key)
+				if err != nil || !replay.Applied {
+					t.Fatalf("promotion replay failed: %+v, %v", replay, err)
+				}
+				assertAuditCount()
+			}
+		})
+	}
+}
