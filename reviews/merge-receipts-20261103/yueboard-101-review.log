+// resetAuditServiceTx extends the existing audit fixture with one operation and
+// its staged authority. It records every audit INSERT without deduplicating it.
+// This checks service writes, not PostgreSQL commit/rollback durability.
+type resetAuditServiceTx struct {
+	resetAuditTx
+	state  string
+	stage  []any
+	audits [][]any
+}
+
+func (tx *resetAuditServiceTx) Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error) {
+	switch {
+	case strings.Contains(sql, "INSERT INTO credential_reset_operations"):
+		if tx.state != "" {
+			return pgconn.NewCommandTag("INSERT 0 0"), nil
+		}
+		tx.state = "pending"
+		tx.hash = append([]byte(nil), args[3].([]byte)...)
+	case strings.Contains(sql, "INSERT INTO credential_reset_stages"):
+		tx.stage = append([]any(nil), args...)
+	case strings.Contains(sql, "UPDATE credential_reset_operations"):
+		tx.state = "applied"
+	case strings.Contains(sql, "INSERT INTO admin_audit_logs"):
+		tx.audits = append(tx.audits, append([]any(nil), args...))
+		tx.auditExists = true
+	}
+	return tx.resetAuditTx.Exec(ctx, sql, args...)
+}
+
+func (tx *resetAuditServiceTx) QueryRow(ctx context.Context, sql string, args ...any) pgx.Row {
+	switch {
+	case strings.Contains(sql, "SELECT request_sha256,state"):
+		return resetAuditRow(func(dst ...any) error {
+			*dst[0].(*[]byte), *dst[1].(*string) = tx.hash, tx.state
+			return nil
+		})
+	case strings.Contains(sql, "SELECT state FROM credential_reset_operations"):
+		return resetAuditRow(func(dst ...any) error {
+			*dst[0].(*string) = tx.state
+			return nil
+		})
+	case strings.Contains(sql, "SELECT NOT EXISTS"):
+		return resetAuditRow(func(dst ...any) error {
+			*dst[0].(*bool) = true
+			return nil
+		})
+	case strings.Contains(sql, "entryretire:load-config"):
+		return resetAuditRow(func(...any) error { return pgx.ErrNoRows })
+	default:
+		return tx.resetAuditTx.QueryRow(ctx, sql, args...)
+	}
+}
+
+type resetAuditStageRows struct {
+	pgx.Rows
+	stage   []any
+	idsOnly bool
+	read    bool
+}
+
+func (r *resetAuditStageRows) Close()     {}
+func (r *resetAuditStageRows) Err() error { return nil }
+func (r *resetAuditStageRows) Next() bool {
+	if r.read || r.stage == nil {
+		return false
+	}
+	r.read = true
+	return true
+}
+func (r *resetAuditStageRows) Scan(dst ...any) error {
+	*dst[0].(*int64) = r.stage[3].(int64)
+	if !r.idsOnly {
+		*dst[1].(*string) = r.stage[4].(string)
+		*dst[2].(*[]byte) = r.stage[5].([]byte)
+		*dst[3].(**int16) = r.stage[7].(*int16)
+	}
+	return nil
+}
+
+func (tx *resetAuditServiceTx) Query(_ context.Context, sql string, _ ...any) (pgx.Rows, error) {
+	if !strings.Contains(sql, "FROM credential_reset_stages") {
+		return nil, fmt.Errorf("unexpected query: %s", sql)
+	}
+	return &resetAuditStageRows{stage: tx.stage, idsOnly: !strings.Contains(sql, "next_uuid")}, nil
+}
+
